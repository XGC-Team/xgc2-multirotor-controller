<?xml version='1.0' encoding='utf-8'?>
<launch>
    <arg name="ns" default="uav1" />
    <arg name="config_file" default="$(find px4_multirotor_controller)/config/uav_nmpc.yaml" />
    <arg name="world_boundary_json" />
    <arg name="pose_source" default="simulation" />
    <arg name="vrpn_pose_topic" default="" />
    <arg name="localization_delay_s" default="" />
    <group ns="$(arg ns)">
        <node pkg="px4_multirotor_controller" type="px4_multirotor_controller_node" name="px4_multirotor_controller" output="screen" respawn="false" clear_params="true">
            <rosparam command="load" file="$(arg config_file)" subst_value="true" />
            <param name="world_boundary_json" type="str" value="$(arg world_boundary_json)" />
            <param name="pose_source" type="str" value="$(arg pose_source)" />
            <param name="vrpn_pose_topic" type="str" value="$(arg vrpn_pose_topic)" if="$(eval arg('vrpn_pose_topic') != '')" />
            <param name="safety/localization_delay_s" type="double" value="$(arg localization_delay_s)" if="$(eval arg('localization_delay_s') != '')" />
        </node>
    </group>
</launch>
