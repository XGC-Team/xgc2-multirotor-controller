{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "xgc2-px4-multirotor-controller-ros1",
      "version": "1.2.0",
      "label": "PX4 multirotor product controller",
      "description": "Unique MAVROS setpoint publisher. Custom1 px4_local is world-frame PV/PVA pass-through; nmpc/dfbc remain estimator body-rate strategies. Does not convert to body frame.",
      "parameters": {
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosInstallPath",
              "rosMasterUri",
              "rosIp"
            ]
          }
        ],
        "required": [
          "worldBoundaryJson"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "default": "uav1"
          },
          "rosInstallPath": {
            "type": "string",
            "default": "/opt/ros/noetic",
            "x-xgc-path-kind": "directory"
          },
          "rosMasterUri": {
            "type": "string",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosIp": {
            "type": "string",
            "default": "127.0.0.1",
            "output": true
          },
          "worldBoundaryJson": {
            "type": "string",
            "description": "Frozen Experiment world boundary in world metres; explicit null means no boundary."
          },
          "configFile": {
            "type": "string",
            "default": "/opt/ros/noetic/share/px4_multirotor_controller/config/uav_nmpc.yaml",
            "x-xgc-path-kind": "file"
          }
        }
      },
      "command": {
        "executable": "${rosInstallPath}/bin/roslaunch",
        "args": [
          "--wait",
          "px4_multirotor_controller",
          "uav_nmpc_controller.launch",
          "ns:=${namespace}",
          "config_file:=${configFile}",
          "world_boundary_json:=${worldBoundaryJson}"
        ],
        "env": {
          "DISABLE_ROS1_EOL_WARNINGS": "1",
          "ROS_IP": "${rosIp}",
          "ROS_MASTER_URI": "${rosMasterUri}"
        }
      },
      "setupFiles": [
        "${rosInstallPath}/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 15000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
