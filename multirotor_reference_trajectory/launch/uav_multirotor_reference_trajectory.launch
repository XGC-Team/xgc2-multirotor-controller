<?xml version='1.0' encoding='utf-8'?>
<launch>
    <arg name="ns" default="uav1" />
    <arg name="config_file" default="$(find multirotor_reference_trajectory)/config/multirotor_reference_trajectory.yaml" />
    <group ns="$(arg ns)">
        <node pkg="multirotor_reference_trajectory" type="multirotor_reference_trajectory_node" name="multirotor_reference_trajectory" output="screen" clear_params="true">
            <rosparam command="load" file="$(arg config_file)" />
        </node>
    </group>
</launch>
